# ============================================================
#  PI School (site + CRM) — șablon de configurare
#  Pe Vercel: Settings → Environment Variables. Local: copiază în `.env`.
#  [NOU] = variabilă adusă odată cu CRM-ul de la Olla.
# ============================================================

# ── OBLIGATORII ──────────────────────────────────────────────
DATABASE_URL="mongodb+srv://USER:PAROLA@cluster.mongodb.net/pischool?retryWrites=true&w=majority"
NEXTAUTH_URL="https://pischool.md"
NEXT_PUBLIC_APP_URL="https://pischool.md"
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# 64 caractere hex — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── RECOMANDATE ──────────────────────────────────────────────
# Protejează /api/cron/*
CRON_SECRET=""
TOTP_APP_NAME="PI School"
SESSION_EXPIRATION_HOURS="8"
STEP_UP_TOKEN_EXPIRATION="300"

# ── TELEGRAM (opțional) ──────────────────────────────────────
# Lead-urile noi și recontactările merg prin botul de lecții, în topicul de contact.
TELEGRAM_LESSONS_BOT_TOKEN=""
TELEGRAM_CONTACT_BOT_TOKEN=""
TELEGRAM_SECURITY_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_LESSONS_CHAT_ID=""
TELEGRAM_CONTACT_CHAT_ID=""
TELEGRAM_SECURITY_CHAT_ID=""
TELEGRAM_MISSED_LESSONS_THREAD_ID=""
TELEGRAM_LOW_LESSONS_THREAD_ID=""
TELEGRAM_ENROLLMENTS_THREAD_ID=""
TELEGRAM_TEACHER_ACTIVITIES_THREAD_ID=""
# [NOU] Topic separat pentru lead-uri / contact (implicit: cel de înscrieri)
TELEGRAM_CONTACT_THREAD_ID=""
# [NOU] Topic pentru alertele de securitate
TELEGRAM_SECURITY_THREAD_ID=""
# [NOU] Secret pentru webhook-ul botului (butoanele din mesaje, /start)
TELEGRAM_WEBHOOK_SECRET=""
# [NOU] Username-ul botului PI School (fără @) — conectarea conturilor la Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# [NOU] Botul de salarii — bot separat (creat la @BotFather), doar pentru salariile profesorilor.
# După deploy: npm run telegram:salary-webhook https://pischool.md
TELEGRAM_SALARY_BOT_TOKEN=""
# [NOU] Cine primește copie după mesajele private către profesori (chat id-uri, separate prin virgulă)
TELEGRAM_SUPERVISOR_CHAT_IDS=""

# ── OPȚIONALE ────────────────────────────────────────────────
# CAPTCHA la login (Cloudflare Turnstile)
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CAPTCHA_FAILURE_THRESHOLD="3"
CAPTCHA_RESET_HOURS="24"

# Upload imagini (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Rate limiting distribuit (fallback automat pe MongoDB)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

AUDIT_LOG_RETENTION_DAYS="90"
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# Conturi inițiale pentru `npm run db:seed` (doar pe o bază goală)
SEED_ADMIN_EMAIL="admin@pischool.md"
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_EMAIL="profesor@pischool.md"
SEED_TEACHER_PASSWORD=""

# ── [NOU] META — paginile Reclame și Mesaje (opțional) ───────
# Fără ele, paginile /admin/ads și /admin/messages arată „neconfigurat".
# Token cu ads_read + pages_show_list (Meta Business → System Users).
META_ACCESS_TOKEN=""
# Doar anumite conturi de reclame (separate prin virgulă)
META_AD_ACCOUNT_IDS=""
# Doar reclamele paginii PI School (id-ul paginii); gol = toate campaniile
META_PAGE_IDS=""
# Pagina PI School ale cărei mesaje apar în /admin/messages (obligatoriu pentru inbox)
META_MESSAGES_PAGE_ID=""
# Token DE PAGINĂ pentru Messenger + Instagram
META_PAGE_ACCESS_TOKEN=""
