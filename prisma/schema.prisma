// Streak: minim 3 probleme/zi pentru a păstra streak-ul

model StudentStreak {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId           String   @unique @db.ObjectId
  current             Int      @default(0)        // streak curent (zile consecutive)
  best                Int      @default(0)        // recordul personal
  lastActiveDay       String?                     // YYYY-MM-DD (UTC) — ultima zi cu ≥3 probleme
  problemsToday       Int      @default(0)        // contor probleme rezolvate azi
  todayDay            String?                     // YYYY-MM-DD curent (resetat la schimbarea zilei)
  freezesAvailable    Int      @default(0)        // streak freezes (cumpărate / oferite)
  freezesUsed         Int      @default(0)
  multiplier          Float    @default(1.0)      // multiplicator XP/Coins din streak
  milestones          String[] @default([])       // ["7","30","100"] — ce milestone a atins
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_streaks")
}

// ==================== COSMETICS ====================

enum CosmeticType {
  THEME
  PROFILE_BANNER
  USERNAME_COLOR
  ANIMATED_FRAME
  LEADERBOARD_EFFECT
  ENTRY_EFFECT
  CODING_AURA
  TITLE
  PET
  RARE_COSMETIC
  ANIMATED_BACKGROUND
  PARTICLE_EFFECT
}

enum Rarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum Currency {
  COINS
  GEMS
}

model Cosmetic {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  type          CosmeticType
  rarity        Rarity        @default(COMMON)
  currency      Currency      @default(COINS)
  price         Int           @default(0)         // 0 = gratuit / doar din chest
  imageUrl      String?
  previewUrl    String?
  cssPayload    Json?         // pentru THEME/colors/animations: {primary, secondary, gradient, glow, css}
  active        Boolean       @default(true)
  shopVisible   Boolean       @default(true)      // false = doar din chest-uri
  themeId       String?       @db.ObjectId        // dacă type=THEME, link la Theme
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  inventory     CosmeticInventory[]
  equipped      EquippedCosmetic[]
  chestRewards  ChestReward[]
  theme         Theme?        @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([type, active])
  @@index([rarity])
  @@map("cosmetics")
}

model CosmeticInventory {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String    @db.ObjectId
  cosmeticId  String    @db.ObjectId
  acquiredAt  DateTime  @default(now())
  source      String?   // "shop" | "chest" | "leaderboard" | "admin"

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic  @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([studentId, cosmeticId])
  @@index([studentId])
  @@map("cosmetic_inventory")
}

model EquippedCosmetic {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String       @db.ObjectId
  cosmeticId  String       @db.ObjectId
  type        CosmeticType
  equippedAt  DateTime     @default(now())

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic     @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([studentId, type])
  @@index([studentId])
  @@map("equipped_cosmetics")
}

// ==================== THEMES ====================

model Theme {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  rarity        Rarity     @default(COMMON)
  currency      Currency   @default(COINS)
  price         Int        @default(0)
  active        Boolean    @default(true)
  // Tokens — culori CSS variables
  primary       String     @default("#6366f1")
  secondary     String     @default("#8b5cf6")
  accent        String     @default("#ec4899")
  bgGradient    String?    // ex: "linear-gradient(135deg, #1e3a8a, #6366f1)"
  cardBg        String?    // ex: "rgba(255,255,255,0.05)"
  textColor     String?
  glowColor     String?
  // Fancy
  animationCss  String?    // CSS arbitrar pentru animații
  previewUrl    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  cosmetics     Cosmetic[]

  @@index([active])
  @@map("themes")
}

// ==================== CHESTS ====================

enum ChestTier {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model Chest {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  tier        ChestTier     @default(COMMON)
  currency    Currency      @default(COINS)
  price       Int           @default(100)
  imageUrl    String?
  active      Boolean       @default(true)
  // Garanții (opțional): ex. minimum guaranteed rarity per opening
  guaranteedRarity Rarity?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rewards     ChestReward[]
  openings    ChestOpening[]

  @@map("chests")
}

model ChestReward {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  chestId     String    @db.ObjectId
  cosmeticId  String?   @db.ObjectId         // nullable pentru reward de gems/coins
  weight      Int       @default(10)         // probabilitate relativă
  // Reward alternativ pentru currency drop
  coinsAmount Int?
  gemsAmount  Int?
  createdAt   DateTime  @default(now())

  chest       Chest     @relation(fields: [chestId], references: [id], onDelete: Cascade)
  cosmetic    Cosmetic? @relation(fields: [cosmeticId], references: [id], onDelete: SetNull)

  @@index([chestId])
  @@map("chest_rewards")
}

model ChestOpening {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String    @db.ObjectId
  chestId         String    @db.ObjectId
  rewardCosmeticId String?  @db.ObjectId
  rewardCoins     Int?
  rewardGems      Int?
  createdAt       DateTime  @default(now())

  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chest           Chest     @relation(fields: [chestId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("chest_openings")
}

// ==================== LEADERBOARD EVENTS ====================

enum LeaderboardType {
  XP
  CODING
  GEMS
  COINS
}

model LeaderboardEvent {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  type        LeaderboardType     @default(XP)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean             @default(true)
  // Vizual
  bannerUrl   String?
  themeColor  String?             // hex
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  entries     LeaderboardEntry[]
  rewards     LeaderboardReward[]

  @@index([active, endsAt])
  @@map("leaderboard_events")
}

model LeaderboardEntry {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String           @db.ObjectId
  studentId   String           @db.ObjectId
  score       Int              @default(0)
  rank        Int?
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())

  event       LeaderboardEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([eventId, score])
  @@map("leaderboard_entries")
}

model LeaderboardReward {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  eventId     String           @db.ObjectId
  rank        Int              // 1, 2, 3, ... sau 0 = top10, etc.
  rankTo      Int?             // dacă vrei range (ex 4-10)
  // Tipul de reward (oricare combinație)
  xp          Int?             // XP acordat ca recompensă
  coins       Int?
  gems        Int?
  cosmeticId  String?          @db.ObjectId
  chestId     String?          @db.ObjectId
  title       String?
  customReward String?         // Recompensă liberă: "Gift card Steam $10", "Lecție gratuită", etc.
  createdAt   DateTime         @default(now())

  event       LeaderboardEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  claims      RewardClaim[]

  @@index([eventId, rank])
  @@map("leaderboard_rewards")
}

model RewardClaim {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String            @db.ObjectId
  rewardId    String            @db.ObjectId
  claimedAt   DateTime          @default(now())

  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reward      LeaderboardReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([studentId, rewardId])
  @@map("reward_claims")
}


// ==================== LECȚII DE PROBĂ ====================
// O lecție de probă e un eveniment unic, la o dată și oră anume — nu intră în
// orarul săptămânal al grupei. Poate fi pentru un lead (încă neconvertit) sau
// pentru un elev existent.

model TrialLesson {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  leadId      String?     @db.ObjectId // cine vine la probă, dacă e încă lead
  studentId   String?     @db.ObjectId // sau un elev existent
  groupId     String?     @db.ObjectId // grupa în care asistă (opțional)
  teacherId   String?     @db.ObjectId
  scheduledAt DateTime    // data + ora, o singură dată
  durationMin Int         @default(60)
  status      TrialStatus @default(PROGRAMAT)
  notes       String?
  createdById String?     @db.ObjectId
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  lead      Lead?    @relation("LeadTrials", fields: [leadId], references: [id], onDelete: Cascade)
  student   Student? @relation("StudentTrials", fields: [studentId], references: [id], onDelete: Cascade)
  group     Group?   @relation("GroupTrials", fields: [groupId], references: [id], onDelete: SetNull)
  teacher   User?    @relation("TeacherTrials", fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreatedTrials", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([groupId])
  @@index([leadId])
  @@map("trial_lessons")
}

enum TrialStatus {
  PROGRAMAT // urmează
  PREZENT   // a venit
  ABSENT    // nu a venit
  ANULAT    // anulată
}

// ==================== SALARII PROFESORI ====================
// Fiecare sumă care intră sau iese din salariul unui profesor e un rând aici.
// Soldul = suma tuturor rândurilor nesterse. Nu are relații cu grupa sau
// lecția: istoricul rămâne întreg chiar dacă acelea se șterg, de aceea
// numele se păstrează ca snapshot.

enum SalaryType {
  FIXED        // aceeași sumă pentru fiecare lecție ținută
  PER_PRESENCE // suma × numărul elevilor prezenți
}

enum SalaryEntryKind {
  LESSON     // lecție ținută — adăugată automat
  MAKEUP     // recuperare ținută — adăugată automat
  BONUS      // adăugată manual (ex. lecție nepusă în sistem)
  PAYOUT     // salariul scos — sumă negativă
  ADJUSTMENT // corectare manuală, plus sau minus
}

model SalaryEntry {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  teacherId     String          @db.ObjectId
  teacherName   String?
  kind          SalaryEntryKind
  amount        Float           // + intră în salariu, − iese
  reason        String
  date          DateTime        // când s-a ținut lecția / când s-a făcut operația — după ea se împarte pe luni

  // Doar pentru lecții și recuperări
  groupId       String?         @db.ObjectId
  groupName     String?
  sessionId     String?         @db.ObjectId
  makeupId      String?         @db.ObjectId
  salaryType    SalaryType?     // regula grupei în momentul lecției
  rate          Float?
  presentCount  Int?
  studentsCount Int?

  // Odată editată de mână, suma nu mai e recalculată automat
  manual        Boolean         @default(false)

  createdById   String?         @db.ObjectId
  createdByName String?
  editedAt      DateTime?
  editedByName  String?
  deleted       Boolean         @default(false)
  deletedAt     DateTime?
  deletedByName String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([teacherId, date])
  @@index([sessionId])
  @@index([makeupId])
  @@index([date])
  @@map("salary_entries")
}

// ==================== CACHE PENTRU DATE EXTERNE ====================

/// Răspunsuri de la Meta, ținute între cereri.
///
/// Memoria unei funcții serverless trăiește doar cât instanța ei, iar Vercel
/// pornește mai multe — așa că fiecare deschidere de pagină nimerea deseori o
/// instanță „rece" și aștepta din nou după Meta. Aici răspunsul e comun.
model ExternalCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique  // ex. "meta:inbox"
  payload   Json
  updatedAt DateTime @updatedAt

  @@map("external_cache")
}

// =====================================================================
//  SITE PUBLIC PI SCHOOL — cursuri, înscrieri, recenzii, mesaje de contact
//  (nu există la Olla; cererile noi de pe site intră și ca lead-uri în CRM)
// =====================================================================

// ==================== COURSES ====================

model Course {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String    @unique
  descriptionShort String
  descriptionLong  String?
  category         String?
  level            String?   // "Începător", "Intermediar", "Avansat"
  ageMin           Int?
  ageMax           Int?
  duration         String?   // "60 min", "90 min"
  lessonsCount     Int?
  price            Float     @default(0)
  discountPrice    Float?    // Prețul redus (opțional)
  seatsTotal       Int       @default(10)
  active           Boolean   @default(true)
  imageUrl         String?   // Imagine principală (deprecated, se folosește mainImageUrl)
  mainImageUrl     String?   // Imaginea principală selectată
  images           String[]  // Array de URL-uri pentru toate imaginile
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  enrollments Enrollment[]
  groups      Group[]
  reviews     Review[]

  @@map("courses")
}

// ==================== ENROLLMENTS (formular curs) ====================

model Enrollment {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  courseId      String           @db.ObjectId
  studentName   String
  studentAge    Int?
  parentName    String
  parentPhone   String
  parentEmail   String
  city          String?
  observations  String?
  status        EnrollmentStatus @default(NEW)
  notes         String?          // Legacy - kept for backwards compatibility
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentNotes EnrollmentNote[] @relation("EnrollmentNotes")

  @@map("enrollments")
}

model EnrollmentNote {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  enrollmentId String?  @db.ObjectId
  inscriereId  String?  @db.ObjectId
  content      String
  createdAt    DateTime @default(now())

  // Relations
  enrollment   Enrollment? @relation("EnrollmentNotes", fields: [enrollmentId], references: [id], onDelete: Cascade)
  inscriere    Inscriere?  @relation("InscriereNotes", fields: [inscriereId], references: [id], onDelete: Cascade)

  @@map("enrollment_notes")
}

enum EnrollmentStatus {
  LEAD
  FARA_RASPUNS
  CONTACTAT
  PROGRAMAT
  PRIMA_LECTIE
  FINALIZAT_LECTIA
  SE_GANDESTE
  ASTEPTAM_PLATA
  PLATIT
  STUDIAZA
  PLECAT
  LOST_LEAD
  TEST
  // Legacy statuses for backwards compatibility
  NEW
  CONTACTED
  CONFIRMED
  REJECTED
}

// ==================== REVIEWS ====================

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  authorName String
  roleLabel  String?  // "Părinte", "Elev"
  rating     Int      @default(5) // 1-5
  message    String
  avatarUrl  String?
  courseId   String?  @db.ObjectId
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

// ==================== INSCRIERI (formularul /inscriere) ====================

model Inscriere {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  numeParinte  String
  numeCopil    String
  email        String
  telefon      String
  clasa        String
  cursuri      String[]
  mesaj        String?
  status       InscriereStatus @default(LEAD)
  notes        String?         // Legacy - kept for backwards compatibility
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  inscriereNotes EnrollmentNote[] @relation("InscriereNotes")

  @@map("inscrieri")
}

enum InscriereStatus {
  // Legacy statuses (keep for backwards compatibility)
  NOU
  CONTACTAT
  CONFIRMAT
  RESPINS
  // CRM statuses
  LEAD
  FARA_RASPUNS
  PROGRAMAT
  PRIMA_LECTIE
  FINALIZAT_LECTIA
  SE_GANDESTE
  ASTEPTAM_PLATA
  PLATIT
  STUDIAZA
  PLECAT
  LOST_LEAD
  TEST
}

// ==================== CONTACT MESSAGES ====================

model ContactMessage {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  message   String
  status    ContactMessageStatus @default(LEAD)
  notes     String?              // Legacy - kept for backwards compatibility
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Relations
  contactNotes ContactNote[] @relation("ContactNotes")

  @@map("contact_messages")
}

model ContactNote {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  contactMessageId String   @db.ObjectId
  content          String
  createdAt        DateTime @default(now())

  // Relations
  contactMessage   ContactMessage @relation("ContactNotes", fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@map("contact_notes")
}

enum ContactMessageStatus {
  LEAD
  FARA_RASPUNS
  CONTACTAT
  PROGRAMAT
  PRIMA_LECTIE
  FINALIZAT_LECTIA
  SE_GANDESTE
  ASTEPTAM_PLATA
  PLATIT
  STUDIAZA
  PLECAT
  LOST_LEAD
  TEST
  // Legacy statuses for backwards compatibility
  NOU
  CITIT
  RASPUNS
  ARHIVAT
}
