  @@index([studentId, paymentDate])
  @@index([expiresAt])
  @@map("learning_payments")
}

// ==================== GAMIFICATION 2.0 ====================
// Economy: Coins (= XP mirror), Gems (premium, doar din coding)

model StudentEconomy {
