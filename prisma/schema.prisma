// Prisma schema for PI School CRM - MongoDB
// CRM-ul (elevi, grupe, lead-uri, plăți...) e același ca la Olla English;
// la final sunt modelele site-ului public PI School (cursuri, înscrieri, recenzii, contact).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  password          String?   // null for Google-only users (Argon2id hash)
  name              String?
  phone             String?   // Număr de telefon (opțional)
  telegramChatId    String?   // Chat ID pentru notificări Telegram (completat automat la /start)
  telegramUsername  String?   // @username-ul de Telegram, pentru afișare
  telegramLinkToken String?   // Token de unică folosință pentru linkul de conectare
  telegramLinkExpires DateTime? // Expirarea token-ului de conectare
  image             String?
  role              Role      @default(TEACHER)
  permissions       String[]  @default([]) // Granular permissions for ADMIN
  emailVerified     DateTime?
  active            Boolean   @default(true)
  superTeacher      Boolean   @default(false) // Profesor "super" - poate porni lecții la orice dată/oră, fără restricții de program
  canViewAllSchedules Boolean @default(false) // Profesorul vede orarul intregii scoli, nu doar grupele lui
  
  // 2FA fields
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // Encrypted TOTP secret (AES-256-GCM)
  twoFactorSetupAt  DateTime? // When 2FA was enabled
  twoFactorAllowed  Boolean   @default(false) // Admin must allow 2FA for non-admin users
  
  // Password reset
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  teacherGroups     Group[]           @relation("TeacherGroups")
  makeupLessons     MakeupLesson[]    @relation("TeacherMakeups")
  notifications     Notification[]    @relation("UserNotifications")
  sessions          AuthSession[]     @relation("UserSessions")
  backupCodes       BackupCode[]      @relation("UserBackupCodes")
  trustedDevices    TrustedDevice[]   @relation("UserTrustedDevices")
  auditLogs         AuditLog[]        @relation("UserAuditLogs")
  createdStudents   Student[]         @relation("CreatedStudents")
  createdPayments   Payment[]         @relation("CreatedPayments")
  createdProblems   Problem[]         @relation("CreatedProblems")
  createdSets       GeneratedSet[]    @relation("CreatedSets")
  bonusPointsAdded  BonusPoint[]      @relation("BonusPointsAdded")
  createdLeads      Lead[]            @relation("CreatedLeads")
  assignedLeads     Lead[]            @relation("AssignedLeads")
  teacherTrials     TrialLesson[]     @relation("TeacherTrials")
  createdTrials     TrialLesson[]     @relation("CreatedTrials")
  createdLessonPackages GroupLessonPackage[] @relation("CreatedLessonPackages")

  @@map("users")
}

enum Role {
  SUPERADMIN
  ADMIN
  TEACHER
}

// ==================== AUTH SESSIONS ====================

model AuthSession {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  token           String    @unique // Session token hash
  deviceId        String?   // Device identifier
  ipAddress       String?
  userAgent       String?
  
  // 2FA state
  twoFactorVerified Boolean   @default(false)
  recent2faAt       DateTime? // Last step-up 2FA verification
  
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ==================== BACKUP CODES ====================

model BackupCode {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  codeHash  String    // Hashed backup code
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  
  // Relations
  user      User      @relation("UserBackupCodes", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("backup_codes")
}

// ==================== TRUSTED DEVICES ====================

model TrustedDevice {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  deviceId    String    // Device cookie/fingerprint
  name        String?   // Device name/description
  ipAddress   String?
  userAgent   String?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  
  // Relations
  user        User      @relation("UserTrustedDevices", fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, deviceId])
  @@index([userId])
  @@map("trusted_devices")
}

// ==================== RATE LIMITING ====================

model RateLimitBucket {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  key         String    @unique // email:action or ip:action or deviceId:action
  action      String    // "login", "2fa", "forgot", "stepup"
  count       Int       @default(0)
  firstAttempt DateTime @default(now())
  lastAttempt DateTime  @default(now())
  lockedUntil DateTime?
  
  @@index([lockedUntil])
  @@map("rate_limit_buckets")
}

// ==================== STEP-UP TOKENS ====================

model StepUpToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String    @unique
  userId      String    @db.ObjectId
  action      String    // "createUser", "changeRole", "export", "delete"
  ipAddress   String?
  deviceId    String?
  used        Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  
  @@index([expiresAt])
  @@map("step_up_tokens")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  action      String    // "login", "login_failed", "2fa_setup", "2fa_verify", "create_user", "change_role", "export", "delete", etc.
  actorId     String?   @db.ObjectId // User who performed the action (null for anonymous)
  targetId    String?   // Target resource ID (userId, resourceId, etc.)
  targetType  String?   // "user", "group", "student", etc.
  ipAddress   String?
  deviceId    String?
  userAgent   String?
  details     Json?     // Additional details (changes, before/after, etc.)
  severity    String    @default("info") // "info", "warning", "critical"
  success     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  
  // Relations
  actor       User?     @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
  @@map("audit_logs")
}

// ==================== SECURITY ALERTS ====================

model SecurityAlert {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  type        String    // "brute_force", "suspicious_login", "2fa_disabled", "admin_created", etc.
  severity    String    @default("warning") // "warning", "critical"
  title       String
  message     String
  details     Json?
  ipAddress   String?
  userId      String?   @db.ObjectId
  acknowledged Boolean  @default(false)
  acknowledgedBy String? @db.ObjectId
  acknowledgedAt DateTime?
  sentVia     String[]  @default([]) // ["telegram", "email"]
  createdAt   DateTime  @default(now())
  
  @@index([type])
  @@index([severity])
  @@index([acknowledged])
  @@index([createdAt])
  @@map("security_alerts")
}

// ==================== CAPTCHA STATE ====================

model CaptchaState {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  key         String    @unique // email or ip
  failures    Int       @default(0)
  requiresCaptcha Boolean @default(false)
  lastFailure DateTime?
  createdAt   DateTime  @default(now())
  
  @@map("captcha_states")
}

// ==================== STUDENTS ====================

model Student {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  age          Int?
  isAdult      Boolean @default(false) // Elev adult — fără părinte și fără clasă
  level        String?  // Nivelul (Clasa a 5-a, Bacalaureat, Olimpiadă… — vezi lib/levels.js)
  parentName   String?
  parentPhone  String?
  parentEmail  String?
  notes        String?
  accessToken  String?  // token persistent pentru portalul elevului /learn/[token] (unique enforced in app code)
  password     String?  // hash parolă opțional pentru autentificare alternativă (Argon2id)
  active       Boolean  @default(true) // dacă e false, /learn/[token] returnează acces interzis
  superStudent Boolean  @default(false) // Super elev — accesează orice lecție din orice modul, indiferent de progres
  grade        Int?     // Clasa elevului (1-12); null = nespecificată

  // Luna în care începe elevul — poate fi peste luni sau ani, până atunci
  // stă în listă fără grupă. null = începe imediat / nespecificat.
  startYear    Int?
  startMonth   Int?     // 1-12

  // Cum invata: singur sau in grupa, online sau la sediu
  lessonType   String?  // 'grup' | 'individual'
  locationType String?  // 'online' | 'offline'

  // Limite per-elev (override peste grupă/global; null = folosește valoarea super-setării)
  cooldownOverrideMin Int?     // în minute, null = moștenește de la grupă/global
  dailyXpCapOverride  Int?     // în puncte XP, null = moștenește
  cooldownDisabled    Boolean  @default(false) // dezactivează explicit cooldown pentru acest elev
  xpCapDisabled       Boolean  @default(false) // dezactivează explicit cap-ul de XP
  lastProblemSolvedAt DateTime? // pentru calcul cooldown
  lastSolvedLessonId  String?   // lecția în care s-a rezolvat ultima problemă (cooldown per lecție)

  // Single-session enforcement: doar 1 browser activ per cont la /learn/[token]
  activeSessionId  String?   // ID-ul ultimului browser care a făcut „claim"
  activeSessionAt  DateTime? // când a fost ultima dată activ
  activeSessionIp  String?   // IP-ul (informativ, pentru audit)
  activeSessionUA  String?   // User-Agent (informativ, pentru audit)

  createdById  String?  @db.ObjectId // ID-ul userului care a creat elevul (profesor sau admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdBy            User?     @relation("CreatedStudents", fields: [createdById], references: [id], onDelete: SetNull)
  groupStudents        GroupStudent[]
  trialLessons         TrialLesson[]        @relation("StudentTrials")
  attendances          Attendance[]
  lessonTransactions   LessonTransaction[]
  makeupLessonStudents MakeupLessonStudent[]
  notifications        Notification[]
  problemAttempts      ProblemAttempt[]
  generatedSets        GeneratedSet[]
  moduleAccesses       ModuleAccess[]
  moduleAdvances       ModuleAdvance[]
  hiddenModules        ModuleHidden[]
  lessonAccesses       LessonAccess[]
  lessonProgresses     LessonProgress[]
  problemSubmissions   ProblemSubmission[]
  learningPayments     LearningPayment[]
  bonusPoints          BonusPoint[]

  // Gamification 2.0
  economy              StudentEconomy?
  streak               StudentStreak?
  inventory            CosmeticInventory[]
  equipped             EquippedCosmetic[]
  chestOpenings        ChestOpening[]
  leaderboardEntries   LeaderboardEntry[]
  rewardClaims         RewardClaim[]
  activeThemeId        String?            @db.ObjectId

  @@index([createdById])
  @@index([accessToken])
  @@index([active])
  @@map("students")
}

// ==================== BONUS POINTS ====================

model BonusPoint {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  points    Int
  reason    String
  addedById String   @db.ObjectId
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedBy   User     @relation("BonusPointsAdded", fields: [addedById], references: [id])

  @@index([studentId])
  @@map("bonus_points")
}

// ==================== SYSTEM SETTINGS (singleton) ====================
// Setări globale: cooldown probleme, cap XP zilnic, curba de niveluri.
// Doar UN singur rând în acest model (singleton); creat la primul GET dacă lipsește.

model SystemSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId

  // Cooldown între rezolvarea a 2 probleme (în minute). Default 4h = 240 min.
  problemCooldownMin  Int      @default(240)
  cooldownEnabled     Boolean  @default(true)

  // Cap zilnic de XP per elev. Default 500 XP/zi.
  dailyXpCap          Int      @default(500)
  xpCapEnabled        Boolean  @default(true)

  // Curba de niveluri — array crescator de praguri XP. Index 0 = nivel 1.
  // Default progresie exponențială dificil de atins la niveluri mari.
  levelCurve          Int[]    @default([0, 100, 300, 700, 1500, 3000, 6000, 12000, 25000, 50000])
  levelNames          String[] @default(["Novice","Explorator","Practicant","Expert","Master","Legend","Mythic","Titan","Sage","Immortal"])

  // Conversațiile de pe Messenger/Instagram devin lead-uri automat.
  // Comutatorul stă în Securitate și e vizibil doar SUPERADMIN-ului.
  metaLeadsEnabled     Boolean   @default(false)
  metaLeadsLastSyncAt  DateTime?
  metaLeadsCreated     Int       @default(0)

  updatedAt           DateTime @updatedAt
  updatedById         String?  @db.ObjectId

  @@map("system_settings")
}

// ==================== BRANCHES (FILIALE) ====================

model Branch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // "Centru", "Ciocana", "Botanica", etc.
  address   String?  // Adresa filialei (opțional)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  groups        Group[]
  makeupLessons MakeupLesson[]

  @@map("branches")
}

// ==================== GROUPS ====================

model Group {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  level           String?  // Nivelul grupei: "Clasa a 5-a", "Bacalaureat", "Olimpiadă" etc.
  courseId        String?  @db.ObjectId // Cursul de pe site (opțional; grupele vechi PI School îl au)
  teacherId       String   @db.ObjectId
  branchId        String?  @db.ObjectId // Filiala (opțional)
  scheduleDays    String[] // ["Mon", "Wed"]
  scheduleTime    String?  // "18:00"
  locationType    String?  // "offline" / "online"
  locationDetails String?  // Sala/Link
  startDate       DateTime?
  notes           String?  // Detalii despre grupă (manual, condiții, observații)

  // Cum se plătește: lunar pe grupă (implicit) sau individual, pe lecții
  billingType     BillingType @default(MONTHLY)
  monthlyLessons  Int      @default(8) // Câte lecții se achită lunar pentru grupă (poate fi suprascris pe o lună anume)

  // Cât primește profesorul pentru o lecție ținută cu grupa. Fără setare,
  // lecțiile nu se adaugă singure la salariu.
  salaryType      SalaryType?
  salaryAmount    Float?   // lei: pe lecție (FIXED) sau pe elev prezent (PER_PRESENCE)

  // Lecție de probă: eveniment unic, cu dată și oră proprie, fără orar săptămânal
  isTrial         Boolean  @default(false)
  trialDate       DateTime?
  active          Boolean  @default(true)

  // Grupa și-a încheiat cursul. Rămâne cu tot istoricul, dar iese din
  // liste, din orar și din notificări — altfel încurcă la fiecare pas.
  completedAt     DateTime?
  completedById   String?  @db.ObjectId

  // Limite per-grupă (override peste global; null = moștenește)
  cooldownOverrideMin Int?
  dailyXpCapOverride  Int?
  cooldownDisabled    Boolean @default(false)
  xpCapDisabled       Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  course              Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher             User                @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  groupStudents       GroupStudent[]
  lessonSessions      LessonSession[]
  lessonTransactions  LessonTransaction[]
  makeupLessons       MakeupLesson[]
  missedSessions      MissedSession[]
  lessonPackages      GroupLessonPackage[]
  trialLessons        TrialLesson[]       @relation("GroupTrials")

  @@map("groups")
}

// ==================== PACHETE LUNARE DE LECȚII (per grupă) ====================
// Câte lecții s-au achitat pentru grupă într-o lună (de regulă 8).
// Lecțiile efectuate se numără din LessonSession-urile lunii respective;
// pachetul e informativ și nu afectează contorul de lecții per elev.

model GroupLessonPackage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId      String   @db.ObjectId
  year         Int
  month        Int      // 1–12
  totalLessons Int      @default(8)
  notes        String?
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CreatedLessonPackages", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([groupId, year, month])
  @@index([groupId])
  @@map("group_lesson_packages")
}

// ==================== GROUP-STUDENT PIVOT ====================

model GroupStudent {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId          String             @db.ObjectId
  studentId        String             @db.ObjectId
  lessonsRemaining Int                @default(0)
  absences         Int                @default(0)
  status           GroupStudentStatus @default(ACTIVE)
  statusNote       String?            // Motiv pentru plecare/pauză
  statusChangedAt  DateTime?          // Când s-a schimbat statusul
  enrolledAt       DateTime           @default(now())

  // Relations
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([groupId, studentId])
  @@map("group_students")
}

enum BillingType {
  MONTHLY    // grupa are N lecții pe lună, achitate indiferent de prezență
  INDIVIDUAL // fiecare elev cumpără un număr de lecții, care se consumă la prezență
}

enum GroupStudentStatus {
  ACTIVE       // Activ - participă la lecții
  PAUSED       // Pauză temporară
  LEFT         // A plecat din grupă
  COMPLETED    // A terminat cursul
  TRANSFERRED  // Transferat la altă grupă
}

// ==================== LESSON SESSIONS ====================

model LessonSession {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId         String   @db.ObjectId
  date            DateTime
  notes           String?
  lessonsDeducted Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relations
  group               Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances         Attendance[]
  lessonTransactions  LessonTransaction[]

  @@map("lesson_sessions")
}

// ==================== ATTENDANCE ====================

model Attendance {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String           @db.ObjectId
  studentId String           @db.ObjectId
  status    AttendanceStatus @default(ABSENT)
  notes     String?
  createdAt DateTime         @default(now())

  // Relations
  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendances")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

// ==================== LESSON TRANSACTIONS (AUDIT) ====================

model LessonTransaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  groupId   String   @db.ObjectId
  sessionId String?  @db.ObjectId
  delta     Int      // -1 for deduction, +1 for addition
  reason    String?
  createdAt DateTime @default(now())

  // Relations
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  session LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("lesson_transactions")
}

// ==================== MAKEUP LESSONS ====================

model MakeupLesson {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId           String             @db.ObjectId
  teacherId         String             @db.ObjectId
  branchId          String?            @db.ObjectId  // Filiala (opțional)
  locationDetails   String?                          // Sala/Link
  scheduledAt       DateTime
  status            MakeupLessonStatus @default(SCHEDULED)
  notes             String?
  lessonsDeducted   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  group           Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher         User                  @relation("TeacherMakeups", fields: [teacherId], references: [id], onDelete: Cascade)
  branch          Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  students        MakeupLessonStudent[]

  @@map("makeup_lessons")
}

model MakeupLessonStudent {
  id             String                     @id @default(auto()) @map("_id") @db.ObjectId
  makeupLessonId String                     @db.ObjectId
  studentId      String                     @db.ObjectId
  status         MakeupLessonStudentStatus  @default(PENDING)
  notes          String?
  createdAt      DateTime                   @default(now())

  // Relations
  makeupLesson MakeupLesson @relation(fields: [makeupLessonId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([makeupLessonId, studentId])
  @@map("makeup_lesson_students")
}

enum MakeupLessonStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum MakeupLessonStudentStatus {
  PENDING
  PRESENT
  ABSENT
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  type        NotificationType
  title       String
  message     String
  link        String?          // URL pentru acțiune (ex: /admin/students/123)
  recipientId String?          @db.ObjectId // User ID (profesor/admin) sau null pentru toți adminii
  studentId   String?          @db.ObjectId // Elev relevant (opțional)
  groupId     String?          @db.ObjectId // Grupă relevantă (opțional)
  data        Json?            // Date adiționale (lessonsRemaining, etc.)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relations
  recipient User?    @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  TEACHER_DAILY_SCHEDULE  // Profesorul are lecții azi
  LOW_LESSONS            // Elev cu puține lecții (sub 3)
  ZERO_LESSONS           // Elev cu 0 lecții
  NEGATIVE_LESSONS       // Elev cu lecții negative
  PAYMENT_RECEIVED       // Plată primită
  NEW_ENROLLMENT         // Înscriere nouă
  MISSED_SESSION         // Lecție ratată
  LATE_SESSION           // Lecție nepornită (2+ ore întârziere)
  CANCELLED_SESSION      // Lecție anulată de profesor
  REVISION_REQUEST       // Profesorul a cerut refacerea unei probleme
  LEAD_FOLLOWUP          // Lead de recontactat azi
  SALARY_UPDATE          // S-a adăugat/scos o sumă din salariul profesorului
}

// ==================== PAYMENTS ====================

model Payment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  groupStudentId String?       @db.ObjectId  // Opțional: rămâne NULL dacă elevul/grupa au fost șterse
  amount         Float         // Suma achitată (RON)
  paymentDate    DateTime      @default(now())
  // Luna acoperită de plată (nu ziua în care a intrat banul)
  forYear        Int?
  forMonth       Int?          // 1–12
  paymentMethod  String?       // "cash", "card", "transfer"
  notes          String?       // Notițe adiționale
  lessonsAdded   Int?          // Câte lecții s-au adăugat pentru această plată
  // Cât a rămas de plată după această tranșă. 0 sau null = achitat integral.
  debt           Float?
  createdById    String?       @db.ObjectId // Cine a înregistrat plata (profesor sau admin)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Snapshot pentru păstrare istoric când entitățile asociate sunt șterse
  studentNameSnapshot  String?  // Numele elevului la momentul plății
  groupNameSnapshot    String?  // Numele grupei la momentul plății
  levelSnapshot        String?  // Nivelul grupei la momentul plății

  // Relations
  groupStudent GroupStudent? @relation(fields: [groupStudentId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("payments")
}

// ==================== LEADS (PIPELINE VÂNZĂRI) ====================

/// Un copil de pe un lead. Un părinte poate întreba pentru doi-trei odată,
/// fiecare cu vârsta și nivelul lui — la conversie iese câte un elev de fiecare.
type LeadChild {
  name         String
  age          Int?
  isAdult      Boolean @default(false)
  level        String?  // Nivelul dorit: Clasa a 7-a, Bacalaureat…
  lessonType   String?  // 'grup' | 'individual'
  locationType String?  // 'online' | 'offline'
}

model Lead {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String     // Persoana de contact (părinte sau viitorul elev)
  phone        String?
  email        String?
  source       LeadSource @default(ALTA)
  sourceDetail String?    // @user Instagram, numărul de WhatsApp, cine a recomandat...
  message      String?    // Mesajul primit / contextul discuției

  // Cine învață — poate fi altcineva decât persoana de contact
  studentName  String?
  studentAge   Int?
  isAdult      Boolean @default(false) // Adult — nu are rost o vârstă exactă
  interestedIn String?    // Nivelul dorit: Clasa a 7-a, Bacalaureat, Olimpiadă...
  lessonType   String?    // Preferinta: 'grup' | 'individual'
  locationType String?    // Preferinta: 'online' | 'offline'

  status         LeadStatus @default(LEAD)
  nextFollowUpAt DateTime?  // Când trebuie recontactat
  notes          String?    // Legacy — notițele noi stau în LeadNote

  // Lead venit dintr-o conversație Meta — ține legătura, ca să nu se dubleze
  metaConversationId String?  // id-ul conversației de pe Messenger/Instagram
  metaPlatform       String?  // 'messenger' | 'instagram'
  metaPersonId       String?  // id-ul persoanei, pentru răspuns direct
  metaLastMessageAt  DateTime? // ultimul mesaj al ei pe care l-am procesat

  createdById        String?  @db.ObjectId // Cine a introdus lead-ul în CRM
  assignedToId       String?  @db.ObjectId // Cine se ocupă de acest lead
  followUpNotifiedAt DateTime? // Când s-a trimis ultima notificare de recontactare
  convertedStudentId String?  @db.ObjectId // Elevul creat din acest lead
  convertedStudentIds String[] @db.ObjectId // Toți elevii creați (un lead poate avea mai mulți copii)

  // Copiii pentru care se interesează. Primul e oglindit în câmpurile
  // studentName / studentAge / interestedIn de mai sus, ca tot ce citea
  // dinainte un singur elev să meargă mai departe neschimbat.
  children LeadChild[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  createdBy  User?     @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  leadNotes LeadNote[] @relation("LeadNotes")
  trials    TrialLesson[] @relation("LeadTrials")

  @@index([status])
  @@index([metaConversationId])
  @@index([source])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([assignedToId])
  @@map("leads")
}

model LeadNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  leadId     String   @db.ObjectId
  content    String
  authorName String?  // Cine a scris notița
  createdAt  DateTime @default(now())

  lead Lead @relation("LeadNotes", fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_notes")
}

enum LeadSource {
  INSTAGRAM
  MESSENGER
  FACEBOOK
  WHATSAPP
  TELEGRAM
  TIKTOK
  TELEFON
  RECOMANDARE
  WALK_IN
  SITE
  ELEV      // Creat automat din pagina Elevi
  ALTA
}

enum LeadStatus {
  LEAD              // 🔵 Lead nou
  FARA_RASPUNS      // 🔘 Fără răspuns
  CONTACTAT         // 🟡 Contactat
  FOLLOW_UP_1       // 📞 Prima revenire după contact
  FOLLOW_UP_2       // 📲 A doua revenire
  FOLLOW_UP_2_PLUS  // 🔁 Mai mult de două reveniri
  PROGRAMAT_TESTARE // 📝 Programat la testare
  PROGRAMAT         // 🟠 Programat la lecție
  PRIMA_LECTIE      // 🟢 A venit la prima lecție
  FINALIZAT_LECTIA  // ⚫ A terminat lecția de probă
  SE_GANDESTE       // 🔘 Se gândește
  INTERESAT_MAI_TARZIU // 🗓️ Revine mai târziu — nu acum, dar nu e pierdut
  WAITLIST          // 📋 Listă de așteptare (locuri ocupate / grupă în formare)
  ASTEPTAM_PLATA    // 💵 Așteptăm plata
  PLATIT            // 💰 A plătit
  STUDIAZA          // 🟣 Studiază (convertit)
  PLECAT            // 🔴 A plecat
  LOST_LEAD         // ❌ Lead pierdut
  OLD_STUDENT       // 🎒 Fost elev — a mai studiat la noi
  TEST              // 🧪 Test
}

// ==================== MISSED SESSIONS (LECȚII RATATE) ====================

model MissedSession {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId        String   @db.ObjectId
  scheduledDate  DateTime // Data și ora când trebuia să fie lecția
  scheduledDay   String   // Ziua programată (ex: "Mon", "Wed")
  scheduledTime  String   // Ora programată (ex: "18:00")
  reason         String?  // Motivul (ex: "Profesorul nu a pornit lecția la timp")
  acknowledged   Boolean  @default(false) // Dacă admin-ul a văzut/confirmat
  createdAt      DateTime @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("missed_sessions")
}

// ==================== PROBLEM BANK ====================

model Problem {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String           // Cerința problemei (markdown)
  difficulty     ProblemDifficulty @default(EASY)
  topic          String           // ex: "loops", "arrays", "functions"
  subtopic       String?
  type           ProblemType      @default(MULTIPLE_CHOICE)

  // Pentru MULTIPLE_CHOICE: array de variante; correctAnswer = textul corect
  // Pentru CODING: starterCode opțional; expectedOutput sau testCases
  // Pentru SHORT_ANSWER / IO: correctAnswer e răspunsul exact (case-insensitive trim)
  options        String[]         @default([])  // doar pentru grilă
  correctAnswer  String?          // răspunsul corect (text/literă/output)
  starterCode    String?          // pentru coding
  testCases      Json?            // [{ input, expectedOutput }] pentru coding (opțional)

  explanation    String           // EXPLICAȚIA — pas cu pas, AI-like
  hint           String?          // Hint progresiv

  tags           String[]         @default([])
  estimatedTime  Int              @default(5)   // minute
  points         Int              @default(10)
  language       String?          // "python", "javascript" etc. pentru coding

  lessonId       String?          @db.ObjectId  // opțional: aparține unei lecții dintr-un modul
  lessonOrder    Int?                            // ordinea în lecție
  active         Boolean          @default(true)

  createdById    String?          @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  lesson         Lesson?          @relation("LessonProblems", fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy      User?            @relation("CreatedProblems", fields: [createdById], references: [id], onDelete: SetNull)
  attempts       ProblemAttempt[]
  setProblems    SetProblem[]
  submissions    ProblemSubmission[]

  @@index([difficulty, topic, active])
  @@index([topic])
  @@index([lessonId, lessonOrder])
  @@map("problems")
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemType {
  MULTIPLE_CHOICE   // grilă (o singură variantă corectă)
  MULTIPLE_SELECT   // grilă cu mai multe variante corecte (checkbox)
  SHORT_ANSWER      // răspuns scurt text
  CODING            // cod
  INPUT_OUTPUT      // I/O — verifică output exact
  ORDER_IMAGES      // ordonare imagini
  FILL_IN           // completează spațiile (mai multe input-uri inline)
  DRAG_BLOCKS       // trage blocuri/token-uri în locuri goale (sloturi separate)
  DRAG_INLINE       // trage token-uri direct în text (ex: 12 ___ + 36 ___ = ___)
}

model GeneratedSet {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  studentId      String?       @db.ObjectId   // opțional - poate fi un set fără elev anume
  config         Json?         // { difficulty, topic, count, mix } - cum a fost generat
  
  // Politica afișării explicațiilor
  explanationPolicy ExplanationPolicy @default(AFTER_ANSWER)

  // Token unic pentru link public (elevul accesează fără cont)
  accessToken    String        @unique

  timeLimit      Int?          // minute (opțional)
  startedAt      DateTime?
  completedAt    DateTime?

  createdById    String?       @db.ObjectId
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  student        Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("CreatedSets", fields: [createdById], references: [id], onDelete: SetNull)
  setProblems    SetProblem[]
  attempts       ProblemAttempt[]

  @@index([studentId])
  @@map("generated_sets")
}

enum ExplanationPolicy {
  ALWAYS         // ✅ Vezi oricând
  AFTER_ANSWER   // ❌ Doar după ce răspunzi
  AFTER_SET      // ❌ Doar după ce termini setul
}

model SetProblem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  setId       String       @db.ObjectId
  problemId   String       @db.ObjectId
  order       Int          @default(0)

  set         GeneratedSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([setId, problemId])
  @@map("set_problems")
}

model ProblemAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?  @db.ObjectId
  problemId   String   @db.ObjectId
  setId       String?  @db.ObjectId

  answer      String   // ce a trimis elevul
  isCorrect   Boolean  @default(false)
  attempts    Int      @default(1)   // câte încercări la această problemă
  timeSpent   Int      @default(0)   // secunde
  pointsAwarded Int    @default(0)
  
  createdAt   DateTime @default(now())

  student     Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  problem     Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  set         GeneratedSet?  @relation(fields: [setId], references: [id], onDelete: SetNull)

  @@index([studentId, problemId])
  @@index([setId])
  @@index([problemId])
  @@map("problem_attempts")
}

// ==================== LEARNING MODULES ====================

model LearningModule {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  slug           String    @unique
  title          String
  description    String?
  language       String?
  coverImage     String?
  order          Int       @default(0)
  active         Boolean   @default(true)
  grades         Int[]     @default([]) // Clasele la care e vizibil modulul (1-9); gol = vizibil pentru toți
  createdById    String?   @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lessons        Lesson[]
  accesses       ModuleAccess[]
  advances       ModuleAdvance[]
  hiddenModules  ModuleHidden[]

  @@index([order, active])
  @@map("learning_modules")
}

model Lesson {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  moduleId       String    @db.ObjectId
  title          String
  slug           String
  order          Int       @default(0)
  isFree         Boolean   @default(false) // admin alege: true = trial gratuit, false = necesită acces
  theory         String    // markdown / rich text
  videoUrl       String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  module         LearningModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  problems       Problem[]           @relation("LessonProblems")
  progresses     LessonProgress[]
  submissions    ProblemSubmission[]
  accesses       LessonAccess[]

  @@unique([moduleId, slug])
  @@index([moduleId, order])
  @@map("lessons")
}

model ModuleAccess {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  moduleId    String   @db.ObjectId
  source      String?  // "trial" | "paid" | "granted"
  grantedById String?  @db.ObjectId
  notes       String?
  createdAt   DateTime @default(now())

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@map("module_accesses")
}

model ModuleAdvance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  moduleId    String   @db.ObjectId  // după acest modul i se permite avansarea la următorul
  grantedById String?  @db.ObjectId
  notes       String?
  createdAt   DateTime @default(now())

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@map("module_advances")
}

model ModuleHidden {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  moduleId    String   @db.ObjectId
  createdAt   DateTime @default(now())

  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@map("module_hidden")
}

model LessonAccess {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  lessonId    String   @db.ObjectId
  grantedById String?  @db.ObjectId
  notes       String?
  createdAt   DateTime @default(now())

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("lesson_accesses")
}

model LessonProgress {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId           String    @db.ObjectId
  lessonId            String    @db.ObjectId
  theoryCompleted     Boolean   @default(false)
  currentProblemIndex Int       @default(0)
  hintsUsed           String[]  @default([]) // problemId-uri pentru care s-a apăsat hint
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@map("lesson_progresses")
}

model ProblemSubmission {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String           @db.ObjectId
  problemId   String           @db.ObjectId
  lessonId    String?          @db.ObjectId

  answer      String?
  code        String?
  status      SubmissionStatus @default(PENDING)
  autoCorrect Boolean?         // true = verificare automată a trecut, false = nu, null = n/a
  grade       Int?             // 0-100
  feedback    String?

  gradedById  String?          @db.ObjectId
  gradedAt    DateTime?

  source      String?          // "lesson" | "random"
  difficulty  String?          // pentru random
  timeSpent   Int              @default(0)

  // Sistem de încercări/hint/rezolvare
  attemptNumber  Int     @default(1) // a câta încercare la această problemă
  hintUsed       Boolean @default(false) // hint a fost văzut înainte de submit
  solutionViewed Boolean @default(false) // elevul a apăsat „Vezi rezolvarea" (forțează 0p)
  locked         Boolean @default(false) // problemă blocată — nu se mai poate reîncerca

  // AI grading (pentru CODING) — profesorul virtual „Mr. Olla"
  aiGraded         Boolean  @default(false)
  aiReasoning      String?  // explicație pedagogică pentru elev (markdown)
  aiRubric         Json?    // {correctness, style, efficiency} cu scoruri 0-100
  aiSuspectedAi    Boolean  @default(false)
  aiSuspicionScore Int?     // 0-100, cât de probabil e că a folosit AI
  aiTokensIn       Int?     // pentru tracking cost
  aiTokensOut      Int?
  teacherOverride  Boolean  @default(false) // profesorul a suprascris nota AI
  xpAwarded        Int?     // XP efectiv acordat pentru această submisie

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problem     Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  lesson      Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([lessonId])
  @@map("problem_submissions")
}

enum SubmissionStatus {
  PENDING        // așteaptă feedback profesor
  GRADED         // notată (trecută)
  NEEDS_REVISION // profesorul cere refacere
}

// ==================== AI USAGE TRACKING ====================
// Tracking pentru rate limit + cost al apelurilor către OpenAI (Mr. Olla)

model AiUsage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String?  @db.ObjectId
  ip          String?  // pentru rate-limit dacă nu e student logat
  endpoint    String   // "grade-code" | "explain" | "detect-ai" | etc.
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costUsd     Float    @default(0) // cost estimat pentru această cerere
  success     Boolean  @default(true)
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

// Chat istoric: elev ↔ Mr. Olla (clarificări la o problemă)
model AiChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  problemId String   @db.ObjectId
  lessonId  String?  @db.ObjectId
  role      String   // "user" | "assistant"
  content   String
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime @default(now())

  @@index([studentId, problemId, createdAt])
  @@index([createdAt])
  @@map("ai_chat_messages")
}

// ==================== LEARNING APP PAYMENTS ====================
// Plata pentru abonament la aplicația /learn (separat de plata pentru lecții la cursuri)

model LearningPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String   @db.ObjectId
  amount        Float    // suma achitată
  currency      String   @default("MDL")
  paymentDate   DateTime @default(now())
  validDays     Int      @default(30) // perioada de valabilitate în zile
  expiresAt     DateTime // calculat: paymentDate + validDays
  notes         String?
  createdById   String?  @db.ObjectId // userul care a înregistrat plata
  createdAt     DateTime @default(now())
