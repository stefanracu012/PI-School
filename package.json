{
  "name": "pischool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:restore": "node scripts/restore-db.mjs",
    "db:migrate-crm": "node scripts/migrate-pi-to-crm.mjs",
    "analyze": "ANALYZE=true next build",
    "clean": "rimraf .next node_modules/.cache",
    "env:check": "node scripts/check-env.mjs",
    "telegram:topics": "node scripts/setup-telegram-topics.mjs",
    "telegram:webhook": "node scripts/set-telegram-webhook.mjs",
    "telegram:discover": "node scripts/discover-telegram-topics.mjs",
    "test:stats": "node scripts/test-statistics.mjs",
    "test:leads": "node scripts/test-lead-children.mjs",
    "test:groups": "node scripts/test-group-filters.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.7.0",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "otpauth": "^9.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-snowfall": "^2.4.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "png-to-ico": "^3.0.1",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4"
  }
